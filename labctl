#!/usr/bin/env python3
"""labctl — KAIPTC CAIC CyberLab launcher.

A single entrypoint students run from the lab root:
    ./labctl list
    ./labctl start m3
    ./labctl verify m3

It only needs Python 3.11+ (for tomllib) — no pip packages.
"""
import os
import sys

# Make the sibling 'engine' package importable regardless of cwd.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from engine.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
